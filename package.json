{
  "name": "vraky-brno",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:vyskov": "vite -c vite.regional.config.js --mode vyskov",
    "dev:blansko": "vite -c vite.regional.config.js --mode blansko",
    "dev:breclav": "vite -c vite.regional.config.js --mode breclav",
    "build:vyskov": "vite build -c vite.regional.config.js --mode vyskov",
    "build:blansko": "vite build -c vite.regional.config.js --mode blansko",
    "build:breclav": "vite build -c vite.regional.config.js --mode breclav",
    "build:regional": "npm run build:vyskov && npm run build:blansko && npm run build:breclav",
    "build:all": "npm run build && npm run build:regional"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
